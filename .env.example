# Supabase project settings → API
# Set these in Vercel: Project → Settings → Environment Variables
# (Production, Preview, and Development).

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Settings → API → "service_role" secret key.
# NEVER expose this in frontend code — it bypasses Row Level Security.
# It is only ever read inside /api/*.js (server-side).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Monnify (wallet: funding, withdrawals) ---
# From Moniepoint Business → Developers, or developers.monnify.com.
# Use https://sandbox.monnify.com while testing, https://api.monnify.com once live.
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_SECRET_KEY=your-monnify-secret-key
# Settings → Contracts — identifies which product/settlement contract new
# reserved accounts are created under.
MONNIFY_CONTRACT_CODE=your-contract-code
# Bank code reserved accounts are created against. Defaults to Moniepoint
# Microfinance Bank (50515) in code — only set this to override.
MONNIFY_PREFERRED_BANK_CODE=50515
# The account collections settle into — where payouts are sent FROM. Found
# on your Monnify dashboard under Settlement Account / Wallet.
MONNIFY_SETTLEMENT_ACCOUNT_NUMBER=your-monnify-settlement-account-number

# Protects /api/wallet/reconcile from being called by anyone but Vercel's
# own cron trigger. Generate with: openssl rand -base64 32
CRON_SECRET=a-long-random-string

# --- VTpass (data & airtime resale) ---
# From vtpass.com (live) — the only VTU provider wired in this build with
# a verified API (see lib/vend/vtpass.js header comment for why).
# Sandbox: https://sandbox.vtpass.com/api · Live: https://vtpass.com/api
VTPASS_BASE_URL=https://sandbox.vtpass.com/api
VTPASS_API_KEY=your-vtpass-api-key
# GET requests (catalog lookups) use api-key + public-key
VTPASS_PUBLIC_KEY=your-vtpass-public-key
# POST requests (purchases) use api-key + secret-key
VTPASS_SECRET_KEY=your-vtpass-secret-key
# % markup added on top of VTpass's data bundle cost price when computing
# what a trader's wallet gets debited. Airtime is sold at face value
# (no markup) — its margin comes from VTpass's own discount instead.
VEND_DATA_MARKUP_PERCENT=5
